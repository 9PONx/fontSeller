Options -Indexes

# Deny dotfiles (e.g. .env, .git)
RewriteRule (^\.|/\.) - [F,L]

# Serve index directly if someone lands on this folder
DirectoryIndex index.php

# Canonicalize: /<project>/public/<rest>  ->  /<project>/<rest>
# Uses THE_REQUEST so internal rewrites from the root .htaccess are NOT affected.
RewriteEngine On
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/([^/]+)/public(/[^\s]*)?\s
RewriteRule ^ /%1%2 [R=301,L]
